</section>

<section class="timeline-section" id="comecar">
  <div class="wrap">
    <div class="section-head">
      <span class="kicker">O desafio, dia a dia</span>
      <h2>7 passos práticos, um por dia</h2>
    </div>
    <div class="timeline">
      <div class="day">
        <div class="day-num"><strong>01</strong>dia</div>
